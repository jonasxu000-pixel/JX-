<view class="container">
  <view class="status-bar">
    <view class="player-indicator {{currentPlayer === board.BLACK ? 'black' : 'white'}}"></view>
    <text class="status-text">{{statusText}}</text>
  </view>

  <board
    id="board"
    currentPlayer="{{currentPlayer}}"
    locked="{{boardLocked}}"
    controlled="{{isOnline}}"
    bind:onPlace="_onPiecePlaced"
    bind:onWin="_onWin"
  />

  <view class="action-bar" wx:if="{{!isOnline}}">
    <button class="action-btn undo-btn" bindtap="_onUndo">悔棋</button>
    <button class="action-btn restart-btn" bindtap="_onRestart">重新开始</button>
  </view>

  <view class="action-bar" wx:if="{{isOnline && gameOver}}">
    <button class="action-btn restart-btn" bindtap="_onRestartOnline">再来一局</button>
    <button class="action-btn exit-btn" bindtap="_onExitOnline">返回首页</button>
  </view>
</view>
